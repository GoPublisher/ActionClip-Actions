  "action": {
    "category": "developerTools",
    "details": "Encodes ampersands, angle brackets, double quotes, and apostrophes in the safe order needed for embedding text in HTML.",
    "exampleInput": "<p title=\"A&B\">It's ready.</p>",
    "exampleOutput": "&lt;p title=&quot;A&amp;B&quot;&gt;It&#39;s ready.&lt;/p&gt;",
    "icon": "fluent:code-24-regular",
    "id": "510A0C00-0026-4D9A-A001-000000000026",
    "name": "HTML Escape",
    "outputMode": "text_replaceable",
    "privacyKind": "onDevice",
    "privacySummary": "Runs locally in ActionClip’s JavaScript sandbox. Selected text does not leave your Mac.",
    "requirements": "No setup required.",
    "summary": "Escape HTML special characters in selected text.",
    "template": "function run(selected_text) {\n  return selected_text\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}",
    "type": "javascript"
  }
}
